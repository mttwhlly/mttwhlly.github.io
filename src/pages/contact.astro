---
import Layout from '../layouts/Layout.astro';
import { ArrowUpRight, ArrowDownIcon } from '@phosphor-icons/react/dist/ssr';
---

<Layout>
  <main>
    <section class="max-w-2xl mx-auto px-6 pt-12 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-6 gap-y-2 sm:gap-y-1">
        <h1 class="self-start font-mono text-sm text-gray-500 dark:text-gray-400 pt-0.5">Contact</h1>
        <div class="flex flex-col gap-4 text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            I'm Matt Whalley, currently open to Senior Product Engineering roles building AI
            products, design-system infrastructure, or tools that need to hold up at scale. Based
            in St. Augustine, Florida, working remotely.
          </p>

          <div class="flex flex-col gap-2">
            <a
              href="mailto:&#109;&#97;&#116;&#116;&#64;&#109;&#97;&#116;&#116;&#119;&#104;&#97;&#108;&#108;&#101;&#121;&#46;&#99;&#111;&#109;"
              class="inline-flex items-baseline gap-1.5 w-fit text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
            >
              Email
              <ArrowUpRight size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
            </a>
            <a
              href="https://linkedin.com/in/mttwhlly"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-baseline gap-1.5 w-fit text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
            >
              LinkedIn
              <ArrowUpRight size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
            </a>
            <a
              href="https://github.com/mttwhlly"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-baseline gap-1.5 w-fit text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
            >
              GitHub
              <ArrowUpRight size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
            </a>
          </div>

          <div>
            <p class="text-gray-900 dark:text-gray-100 mb-2">Downloads:</p>
            <div class="flex flex-col gap-2">
              <a
                href="/matt-whalley-resume.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-baseline gap-1.5 w-fit text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
              >
                Résumé
                <ArrowDownIcon size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
              </a>
              <a
                href="/matt-whalley-user-manual.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-baseline gap-1.5 w-fit text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
              >
                User manual
                <ArrowDownIcon size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
              </a>
            </div>
          </div>

          <p>
            For background on the work referenced above, see
            <a href="/about" class="underline underline-offset-2 hover:text-gray-900 dark:hover:text-gray-100"
              >About</a
            > and the <a href="/case-studies" class="underline underline-offset-2 hover:text-gray-900 dark:hover:text-gray-100"
              >case studies</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
