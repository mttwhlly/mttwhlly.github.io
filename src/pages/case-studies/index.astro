---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ArrowUpRight } from '@phosphor-icons/react/dist/ssr';

const entries = await getCollection('caseStudies', ({ data }) => !data.draft);
const studies = entries
  .map((entry) => ({
    slug: entry.id.replace(/\.(mdx?)$/, ''),
    ...entry.data,
  }))
  .sort((a, b) => a.order - b.order || b.publishedDate.localeCompare(a.publishedDate));
---

<Layout markdownUrl="/case-studies/index.md">
  <main>
    <section class="max-w-2xl mx-auto px-6 pt-12 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-6 gap-y-2 sm:gap-y-1">
        <h1
          class="self-start font-mono text-sm text-gray-500 dark:text-gray-400 pt-0.5"
        >
          Writing
        </h1>
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
          Deep dives into how the work actually happened.
        </p>
      </div>
    </section>

    <section class="max-w-2xl mx-auto px-6 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-6 gap-y-2 sm:gap-y-1">
        <div class="hidden sm:block" aria-hidden="true"></div>
        <div class="flex flex-col gap-8">
          {
            studies.map((study) => (
              <div>
                <a
                  href={`/case-studies/${study.slug}`}
                  class="inline-flex items-baseline gap-1.5 text-gray-900 dark:text-gray-100 hover:underline underline-offset-2"
                >
                  {study.title}
                  <ArrowUpRight size={12} weight="bold" class="text-gray-400 dark:text-gray-500" />
                </a>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed mt-1">{study.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
