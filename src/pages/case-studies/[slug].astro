---
import Layout from '../../layouts/Layout.astro';
import ArticleStructuredData from '../../components/ArticleStructuredData.astro';
import { getCollection, render } from 'astro:content';
import { CASE_STUDY_LASTMOD, SITE_LASTMOD } from '../../lib/caseStudyDates';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(mdx?)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, description, publishedDate, tags, atAGlance, coverImage } = entry.data;
const slug = entry.id.replace(/\.(mdx?)$/, '');
const dateModified = CASE_STUDY_LASTMOD[slug] ?? SITE_LASTMOD;
const updatedLabel = new Date(`${dateModified}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout
  markdownUrl={`/case-studies/${slug}.md`}
  title={`${title} · Matt Whalley`}
  description={description}
  ogImage={coverImage}
  ogImageWidth={coverImage ? 1792 : undefined}
  ogImageHeight={coverImage ? 448 : undefined}
>
  <Fragment slot="head">
    <ArticleStructuredData
      headline={title}
      description={description}
      datePublished={publishedDate}
      dateModified={dateModified}
      slug={slug}
      tags={tags}
      image={coverImage}
    />
  </Fragment>
  <main>
    <!-- Header -->
    <header class="max-w-2xl mx-auto px-6 pt-12 pb-8">
      <h1 class="text-xl sm:text-2xl font-sans font-semibold text-gray-900 dark:text-gray-100 leading-snug mb-4">
        {title}
      </h1>
      <p class="font-serif italic text-base text-gray-600 dark:text-gray-400 leading-relaxed">
        {subtitle}
      </p>
      <p class="font-mono text-xs text-gray-400 dark:text-gray-500 mt-4">
        Updated {updatedLabel}
      </p>
    </header>

    <!-- At a glance -->
    {
      atAGlance && (
        <section class="max-w-2xl mx-auto px-6 pb-12">
          <div class="grid grid-cols-1 sm:grid-cols-[120px_1fr] gap-x-6 gap-y-3 border-y border-gray-100 dark:border-gray-800 py-6">
            <h2 class="font-mono text-sm text-gray-900 dark:text-gray-100 pt-0.5">At a glance</h2>
            <dl class="flex flex-col gap-3">
              {atAGlance.map(({ label, value }) => (
                <div>
                  <dt class="font-mono text-xs uppercase tracking-wider text-gray-400 dark:text-gray-500">
                    {label}
                  </dt>
                  <dd class="text-gray-700 dark:text-gray-300 leading-relaxed mt-0.5">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <!-- Body -->
    <section class="max-w-2xl mx-auto px-6 pb-16">
      <article class="prose-case-study">
        <Content />
      </article>
    </section>
  </main>
</Layout>
